<?xml version="1.0"?>
<sdf version="1.7">
  <world name="industrial_sludge_pond">
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo Fortress server systems. -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
  <!--
    Plugin for lidar 
  -->    
  <plugin filename="ignition-gazebo-sensors-system"
        name="ignition::gazebo::systems::Sensors">
  <render_engine>ogre2</render_engine>
  </plugin>
  <!--
    Wind environment for the USV.
    Mean wind speed: 3 m/s
    Mean direction: 45 deg in the world XY plane.
  -->
  <wind>
    <linear_velocity>2.121 2.121 0</linear_velocity>
  </wind>

  <plugin filename="ignition-gazebo-wind-effects-system"
          name="gz::sim::systems::WindEffects">

    <!-- Scale factor used by Gazebo's approximate wind-force model. -->
    <force_approximation_scaling_factor>0.05</force_approximation_scaling_factor>

    <!-- Horizontal wind-speed variation. -->
    <horizontal>

      <magnitude>
        <time_for_rise>5</time_for_rise>

        <sin>
          <amplitude_percent>0.05</amplitude_percent>
          <period>60</period>
        </sin>

        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.0002</stddev>
        </noise>
      </magnitude>

      <direction>
        <time_for_rise>10</time_for_rise>

        <sin>
          <amplitude>3</amplitude>
          <period>30</period>
        </sin>

        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.01</stddev>
        </noise>
      </direction>

    </horizontal>

    <!-- No intentional vertical wind; only a very small disturbance. -->
    <vertical>
      <noise type="gaussian">
        <mean>0</mean>
        <stddev>0.001</stddev>
      </noise>
    </vertical>

  </plugin>

    <!-- Apply external force / torque to links -->
    <plugin filename="ignition-gazebo-apply-link-wrench-system"
            name="ignition::gazebo::systems::ApplyLinkWrench"/>

    <!-- Physical buoyancy for the dynamically spawned USV. -->
    <plugin filename="ignition-gazebo-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <!-- Fresh water below z=0; air above z=0. -->
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <!-- Restrict buoyancy to the dynamically spawned USV. -->
      <enable>usv</enable>
    </plugin>

    <scene>
      <ambient>0.60 0.65 0.70 1</ambient>
      <background>0.70 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <!--
      POND GEOMETRY
      Water footprint: x=[-50, 50], y=[-50, 50]
      Water surface: z=0; water bottom: z=-6
      Sludge: z=-6.25 to z=-6
    -->

    <!-- Flat structural bottom beneath the sludge. -->
    <model name="pond_bottom">
      <static>true</static>
      <pose>0 0 -6.75 0 0 0</pose>
      <link name="bottom_link">
        <collision name="collision">
          <geometry><box><size>100 100 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>100 100 1</size></box></geometry>
          <material>
            <ambient>0.08 0.05 0.02 1</ambient>
            <diffuse>0.14 0.09 0.03 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Uniform 0.25 m sludge layer across the complete pond bottom. -->
    <model name="base_sludge">
      <static>true</static>
      <pose>0 0 -6.125 0 0 0</pose>
      <link name="sludge_link">
        <collision name="collision">
          <geometry><box><size>100 100 0.25</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>100 100 0.25</size></box></geometry>
          <material>
            <ambient>0.10 0.045 0.012 1</ambient>
            <diffuse>0.20 0.085 0.020 1</diffuse>
            <specular>0.005 0.005 0.005 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Irregular deposits protruding above the base sludge. -->





<!--
  Water geometry is visual-only.
  Physical buoyancy is provided by the world Buoyancy system.
-->    <model name="pond_water">
      <static>true</static>
      <pose>0 0 -3 0 0 0</pose>

      <link name="water_link">

        <visual name="water_visual">

          <geometry>
            <box>
              <size>100 100 6</size>
            </box>
          </geometry>

          <material>
            <!-- Base color -->
            <ambient>0.02 0.18 0.30 1.0</ambient>

            <!-- Main visible color -->
            <diffuse>0.05 0.45 0.65 1.0</diffuse>

            <!-- Small amount of reflection -->
            <specular>0.18 0.20 0.22 1.0</specular>

            <!-- Slight self illumination -->
            <emissive>0.00 0.05 0.08 1.0</emissive>
          </material>

          <!-- 0 = opaque, 1 = invisible -->
          <transparency>0.40</transparency>

          <cast_shadows>false</cast_shadows>

        </visual>

      </link>
    </model>

    <!--
      FOUR SLOPED SOIL BANKS
      Each incline runs from the pond floor near +/-50 m to ground level
      near +/-60 m. All bank centers remain outside the water footprint.
    -->
    <model name="north_bank">
      <static>true</static>
      <pose>0 50.3 -3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>112 0.6 8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>112 0.6 8</size></box></geometry>
          <material><ambient>0.19 0.11 0.04 1</ambient><diffuse>0.36 0.22 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_bank">
      <static>true</static>
      <pose>0 -50.3 -3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>112 0.6 8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>112 0.6 8</size></box></geometry>
          <material><ambient>0.19 0.11 0.04 1</ambient><diffuse>0.36 0.22 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_bank">
      <static>true</static>
      <pose>50.3 0 -3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 112 8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 112 8</size></box></geometry>
          <material><ambient>0.19 0.11 0.04 1</ambient><diffuse>0.36 0.22 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_bank">
      <static>true</static>
      <pose>-50.3 0 -3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 112 8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 112 8</size></box></geometry>
          <material><ambient>0.19 0.11 0.04 1</ambient><diffuse>0.36 0.22 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      SURROUNDING GRASS TERRAIN
      Four independent strips leave the entire 100 x 100 m excavation open.
    -->
    <model name="north_grass_terrain">
      <static>true</static><pose>0 60 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>140 20 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>140 20 0.5</size></box></geometry><material><ambient>0.10 0.30 0.05 1</ambient><diffuse>0.18 0.48 0.09 1</diffuse></material></visual>
      </link>
    </model>

    <model name="south_grass_terrain">
      <static>true</static><pose>0 -60 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>140 20 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>140 20 0.5</size></box></geometry><material><ambient>0.10 0.30 0.05 1</ambient><diffuse>0.18 0.48 0.09 1</diffuse></material></visual>
      </link>
    </model>

    <model name="east_grass_terrain">
      <static>true</static><pose>60 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 120 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 120 0.5</size></box></geometry><material><ambient>0.10 0.30 0.05 1</ambient><diffuse>0.18 0.48 0.09 1</diffuse></material></visual>
      </link>
    </model>

    <model name="west_grass_terrain">
      <static>true</static><pose>-60 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 120 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 120 0.5</size></box></geometry><material><ambient>0.10 0.30 0.05 1</ambient><diffuse>0.18 0.48 0.09 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Small south-side starting dock extending over the water. -->


    <!-- Lightweight static navigation obstacles. -->



  </world>
</sdf>
